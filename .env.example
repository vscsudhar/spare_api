NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/voltspare
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:3000
FLUTTER_WEB_URL=http://localhost:50000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Owner configuration for seeding
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_PHONE=

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=voltsparesupport@gmail.com

SMTP_PASS=your-gmail-app-password

# Firebase Push Notifications (Admin SDK)
FIREBASE_PROJECT_ID=voltspare
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@voltspare.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

STORAGE_PROVIDER=cloudinary
